{
  "name": "p5-agent-stage",
  "version": "0.1.0",
  "private": true,
  "description": "Big Fish Stage: a game-styled chat client for coding agents (pluggable worker agents, character packs, local web app)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:characters": "node scripts/check-characters.mjs",
    "mock:server": "node scripts/mock-server.mjs",
    "preview": "vite preview",
    "start": "vite build && npm --prefix server run start",
    "dev:server": "npm --prefix server run dev"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
