{
  "name": "bigfish-stage",
  "version": "0.2.0",
  "private": true,
  "description": "BigFish Stage · 大肥鱼工作台 — High-contrast pop-art comic stage for DeepSeek Harness & AI character agents",
  "type": "module",
  "main": "electron/main.cjs",
  "icon": "./dsh-bundle/icon.svg",
  "exports": {
    ".": "./dsh-bundle/index.js",
    "./client": "./dsh-bundle/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./dsh-bundle/locale/*.json",
    "./icon": "./dsh-bundle/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-bundle/**/*",
    "cordis.patch.yml",
    "public/characters/**/*",
    "public/sfx/**/*",
    "docs/screenshots/*.webp",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    }
  },
  "scripts": {
    "build:engine": "esbuild server/src/session.ts server/src/settings-store.ts server/src/characters.ts server/src/git-ops.ts server/src/adapters/registry.ts --bundle --platform=node --format=esm --outdir=electron/engine --external:electron --external:ws",
    "build:stage": "node packages/dsh-client-ui-p5stage/build.mjs",
    "build:all": "npm run build && npm run build:engine && npm run build:stage",
    "app": "npm run build:stage && electron electron/main.cjs",
    "app:build": "npm run build:all && electron electron/main.cjs",
    "dist:mac": "npm run build:all && npx electron-builder --mac --dir",
    "dist:dmg": "npm run build:all && npx electron-builder --mac dmg",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:characters": "node scripts/check-characters.mjs",
    "mock:server": "node scripts/mock-server.mjs",
    "preview": "vite preview",
    "start": "vite build && npm --prefix server run start",
    "dev:server": "npm --prefix server run dev",
    "dsh": "npm run build:stage && dsh --profile bigfish",
    "dsh:web": "npm run build:stage && dsh --profile bigfish --no-open --port 62000"
  },
  "build": {
    "appId": "com.bigfish.stage",
    "productName": "BigFish Stage",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "packages/dsh-client-ui-p5stage/**/*",
      "public/characters/**/*",
      "public/sfx/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
